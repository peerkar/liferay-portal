Bundle-Name: Liferay Generative AI Task Service
Bundle-SymbolicName: com.liferay.generative.ai.task.service
Bundle-Version: 1.0.0
Import-Package:\
	!android.*,\
	\
	!com.aayushatharva.brotli4j.*,\
	\
	!com.github.luben.zstd.*,\
	\
	!com.jcraft.jzlib.*,\
	\
	!com.ning.compress.*,\
	\
	!com.oracle.svm.*,\
	\
	!com.sun.tools.javac.*,\
	\
	!io.netty.channel.unix.*,\
	\
	!io.opentelemetry.*,\
	\
	!kotlinx.coroutines.*,\
	\
	!lzma.sdk.*,\
	\
	!okhttp3.sse.*,\
	\
	!opennlp.tools.*,\
	\
	!org.apache.http.*,\
	!org.apache.log4j.*,\
	\
	!org.bouncycastle.*,\
	\
	!org.eclipse.jetty.*,\
	\
	!org.graalvm.nativeimage.*,\
	\
	!org.jboss.marshalling.*,\
	\
	!reactor.blockhound.*,\
	\
	!sun.net.www.*,\
	\
	!sun.security.*,\
	\
	!sun.util.*,\
	\
	*
Liferay-Require-SchemaVersion: 1.0.0
Liferay-Service: true
-dsannotations-options: inherit
-fixupmessages: Classes found in the wrong directory: ...;is:=ignore