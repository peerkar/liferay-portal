<%
List<String> failedTitles = (List<String>)request.getAttribute("failedTitles");

List<String> ingestedTitles = (List<String>)request.getAttribute("ingestedTitles");
%>

<c:if test="<%= ingestedTitles != null %>">
	<div class="alert-success results">
		<h1><liferay-ui:message key="ingested-items" /></h1>

		<c:choose>
			<c:when test="<%= ingestedTitles.isEmpty() %>">
				<p><liferay-ui:message key="no-items-were-ingested" /></p>
			</c:when>
			<c:otherwise>
				<ul>

					<%
					for (String item : ingestedTitles) {
					%>

						<li><%= item %></li>

					<%
					}
					%>

				</ul>
			</c:otherwise>
		</c:choose>

		<p>
			<strong>Total: </strong> <%= (int)request.getAttribute("ingestedTitlesCount") %>
		</p>
	</div>
</c:if>

<c:if test="<%= (failedTitles != null) && !failedTitles.isEmpty() %>">
	<div class="alert-warning results results-container">
		<h1><liferay-ui:message key="failed-items" /></h1>

		<ul>

			<%
			for (String item : failedTitles) {
			%>

				<li><%= item %></li>

			<%
			}
			%>

		</ul>

		<p>
			<strong>Total: </strong> <%= (int)request.getAttribute("failedTitlesCount") %>
		</p>

		<p><liferay-ui:message key="see-log-for-more-information" /></p>
	</div>
</c:if>