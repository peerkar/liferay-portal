<%
List<String> failedItems = (List<String>)request.getAttribute("failedItems");

List<String> ingestedItems = (List<String>)request.getAttribute("ingestedItems");
%>

<c:choose>
	<c:when test="<%= (ingestedItems != null) && ingestedItems.isEmpty() %>">
		<div class="alert alert-info results">
			<liferay-ui:message key="no-items-were-ingested" />
		</div>
	</c:when>
	<c:when test="<%= (ingestedItems != null) && !ingestedItems.isEmpty() %>">
		<div class="alert-success results">
			<h1><liferay-ui:message key="ingested-items" /></h1>

			<ul>

				<%
				for (String item : ingestedItems) {
				%>

					<li><%= item %></li>

				<%
				}
				%>

			</ul>

			<p>
				<strong>Total: </strong> <%= (int)request.getAttribute("ingestedItemsCount") %>
			</p>
		</div>
	</c:when>
</c:choose>

<c:if test="<% (failedItems != null) && !failedItems.isEmpty() %>">
	<div class="alert-warning results results-container">
		<h1><liferay-ui:message key="failed-items" /></h1>

		<ul>

			<%
			for (String item : failedItems) {
			%>

				<li><%= item %></li>

			<%
			}
			%>

		</ul>

		<p>
			<strong>Total: </strong> <%= (int)request.getAttribute("failedItemsCount") %>
		</p>
	</div>
</c:if>